<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "SAARQ Bienes Raíces" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen font-sans antialiased">

    <header class="bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between gap-6">

        <%= link_to root_path, class: "flex items-center gap-3 shrink-0" do %>
          <img src="/images/logo.png" alt="SAARQ" class="h-[58px] w-auto object-contain">
        <% end %>

        <div class="flex items-center gap-4">
          <a href="https://wa.me/528112145530" target="_blank" rel="noopener" class="text-green-600 hover:text-green-700 transition-colors">
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a href="mailto:info@saarqbienesraices.com" class="text-gray-500 hover:text-gray-700 transition-colors">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <% if notice %>
      <div class="bg-green-50 border-b border-green-100 text-green-700 px-6 py-3 text-sm text-center font-medium">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-50 border-b border-red-100 text-red-700 px-6 py-3 text-sm text-center font-medium">
        <%= alert %>
      </div>
    <% end %>

    <main><%= yield %></main>

    <!-- Chatbot flotante -->
    <div data-controller="chatbot" class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3">

      <!-- Ventana del chat -->
      <div data-chatbot-target="window"
           class="hidden w-80 bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col"
           style="max-height:480px; opacity:0; transform:scale(0.95) translateY(8px); transition:opacity 0.18s ease, transform 0.18s ease;">

        <!-- Encabezado -->
        <div class="bg-olive-600 px-4 py-3 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-white/20 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-bold text-sm leading-tight">SAARQ Asistente</p>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>
                <p class="text-white/70 text-xs">En línea</p>
              </div>
            </div>
          </div>
          <button type="button" data-action="click->chatbot#toggle"
                  class="text-white/60 hover:text-white transition-colors p-1 rounded-full hover:bg-white/10">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Mensajes -->
        <div data-chatbot-target="messages"
             class="flex-1 overflow-y-auto p-4 space-y-3"
             style="min-height:200px; max-height:300px;">
        </div>

        <!-- Input -->
        <div class="border-t border-gray-100 p-3 shrink-0">
          <form data-action="submit->chatbot#send" class="flex gap-2">
            <input data-chatbot-target="input" type="text"
                   placeholder="Escribe un mensaje..."
                   autocomplete="off"
                   class="flex-1 bg-gray-50 border-0 rounded-2xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-olive-300 placeholder-gray-400">
            <button type="submit"
                    class="bg-olive-600 hover:bg-olive-500 active:bg-olive-700 text-white rounded-2xl px-4 py-2.5 transition-colors shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Botón flotante -->
      <button type="button" data-action="click->chatbot#toggle"
              class="w-14 h-14 bg-olive-600 hover:bg-olive-500 active:bg-olive-700 text-white rounded-full shadow-lg hover:shadow-xl transition-all flex items-center justify-center relative">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <span data-chatbot-target="badge"
              class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-bold rounded-full flex items-center justify-center animate-pulse">1</span>
      </button>

    </div>

    <footer class="bg-gray-900 text-white py-10 mt-16">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/images/logo.png" alt="SAARQ" class="h-10 w-auto object-contain brightness-0 invert opacity-80">
        </div>
        <p class="text-xs text-gray-500">&copy; <%= Date.current.year %> SAARQ Bienes Raíces &mdash;
          <%= link_to "Aviso de Privacidad", aviso_privacidad_path, class: "hover:text-white transition-colors" %>
        </p>
      </div>
    </footer>

  </body>
</html>
