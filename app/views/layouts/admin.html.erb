<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Backoffice — SAARQ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gold-50 min-h-screen font-sans antialiased">

    <nav class="bg-olive-900 sticky top-0 z-50" style="box-shadow: 0 1px 0 0 rgba(255,255,255,0.06);">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14 gap-3">

          <div class="flex items-center gap-3 min-w-0">
            <div class="flex items-center gap-2 shrink-0">
              <div class="w-6 h-6 rounded bg-gold-500 flex items-center justify-center">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                </svg>
              </div>
              <span class="text-sm font-semibold text-white tracking-tight">Backoffice</span>
            </div>

            <div class="hidden sm:flex items-center gap-4">
              <div class="w-px h-4 bg-white/10"></div>
              <%= link_to "Propiedades", admin_properties_path, class: "text-xs font-medium text-gold-200 hover:text-white transition-colors" %>
              <%= link_to "Ver sitio →", root_path, target: "_blank", class: "text-xs font-medium text-olive-400 hover:text-gold-300 transition-colors" %>
            </div>
          </div>

          <div class="flex items-center gap-2 sm:gap-4">
            <div class="flex sm:hidden items-center gap-2">
              <%= link_to admin_properties_path, class: "text-xs font-medium text-gold-200 hover:text-white transition-colors px-2 py-1 rounded-lg hover:bg-white/10" do %>
                Propiedades
              <% end %>
              <%= link_to root_path, target: "_blank", class: "text-xs font-medium text-olive-400 hover:text-gold-300 transition-colors px-2 py-1 rounded-lg hover:bg-white/10" do %>
                Sitio
              <% end %>
            </div>
            <%= button_to "Salir", admin_logout_path, method: :delete,
                  class: "text-xs font-medium text-olive-400 hover:text-white bg-transparent border-0 cursor-pointer transition-colors shrink-0" %>
          </div>

        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="bg-gold-50 border-b border-gold-200 text-gold-800 px-4 py-2.5 text-sm text-center font-medium">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-blush-50 border-b border-blush-200 text-blush-700 px-4 py-2.5 text-sm text-center font-medium">
        <%= alert %>
      </div>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
      <%= yield %>
    </main>

    <!-- Diálogo de confirmación personalizado (reemplaza window.confirm para que no se pueda suprimir) -->
    <dialog id="confirm-dialog" class="rounded-2xl shadow-2xl border border-stone-200 p-0 w-[min(22rem,90vw)]">
      <div class="p-6">
        <p id="confirm-message" class="text-sm text-olive-900 font-medium leading-relaxed mb-5"></p>
        <div class="flex gap-3 justify-end">
          <button id="confirm-cancel" type="button"
                  class="px-4 py-2 text-sm font-medium text-stone-500 hover:text-stone-700 rounded-xl hover:bg-stone-100 transition-colors">
            Cancelar
          </button>
          <button id="confirm-ok" type="button"
                  class="px-4 py-2 text-sm font-semibold text-white bg-red-500 hover:bg-red-600 rounded-xl transition-colors">
            Eliminar
          </button>
        </div>
      </div>
    </dialog>
    <style>
      #confirm-dialog::backdrop { background: rgba(0,0,0,0.45); }
    </style>
    <script>
      Turbo.config.confirmMethod = function(message) {
        return new Promise(function(resolve) {
          var dialog  = document.getElementById("confirm-dialog");
          var msgEl   = document.getElementById("confirm-message");
          var okBtn   = document.getElementById("confirm-ok");
          var cancelBtn = document.getElementById("confirm-cancel");
          msgEl.textContent = message;
          function cleanup() {
            okBtn.removeEventListener("click", onOk);
            cancelBtn.removeEventListener("click", onCancel);
            dialog.close();
          }
          function onOk()     { cleanup(); resolve(true);  }
          function onCancel() { cleanup(); resolve(false); }
          okBtn.addEventListener("click", onOk);
          cancelBtn.addEventListener("click", onCancel);
          dialog.showModal();
        });
      };
    </script>
  </body>
</html>
