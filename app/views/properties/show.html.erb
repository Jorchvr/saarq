<%
  wa_phone = "528112145530"
  prop_url = property_url(@property)

  msg  = "Hola, me interesa esta propiedad:\n\n"
  msg += "🏠 *#{@property.tipo_propiedad.capitalize} en #{@property.calle}*\n"
  msg += "📍 #{@property.colonia}, #{@property.ciudad}, #{@property.estado}\n"
  msg += "💰 #{@property.precio_formateado}"
  msg += " /mes" if @property.tipo_operacion == "renta"
  msg += "\n🔗 #{prop_url}"

  if @similares.any?
    msg += "\n\n¿También me interesaría ver propiedades similares?\n"
    @similares.each do |s|
      msg += "\n• #{s.tipo_propiedad.capitalize} en #{s.calle}, #{s.ciudad} — #{s.precio_formateado}\n  #{property_url(s)}"
    end
  end

  wa_url = "https://wa.me/#{wa_phone}?text=#{u(msg)}"
%>

<div class="max-w-5xl mx-auto px-6 py-10">
  <%= link_to root_path, class: "inline-flex items-center gap-2 text-sm text-gray-400 hover:text-gray-700 transition-colors mb-8" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
    Regresar
  <% end %>

  <div class="bg-white rounded-3xl shadow-md overflow-hidden">

    <!-- Galería -->
    <% if @property.imagenes.attached? %>
      <div data-controller="gallery">

        <%# Grid de miniaturas %>
        <div class="<%= @property.imagenes.size == 1 ? '' : 'grid grid-cols-2 md:grid-cols-3 gap-1' %> bg-gray-100">
          <% @property.imagenes.each_with_index do |img, i| %>
            <button type="button"
                    data-gallery-target="thumb"
                    data-full="<%= url_for(img) %>"
                    data-index="<%= i %>"
                    data-action="click->gallery#open"
                    class="relative group focus:outline-none overflow-hidden <%= i == 0 && @property.imagenes.size > 1 ? 'col-span-2 row-span-2 h-96' : 'h-44' %>">
              <%= image_tag url_for(img),
                    class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                    loading: i == 0 ? "eager" : "lazy",
                    decoding: "async",
                    alt: "" %>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-200 flex items-center justify-center">
                <svg class="w-10 h-10 text-white opacity-0 group-hover:opacity-100 drop-shadow transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 11A6 6 0 115 11a6 6 0 0112 0zm-2-2v4m-2-2h4"/>
                </svg>
              </div>
              <% if i == 0 && @property.imagenes.size > 1 %>
                <span class="absolute bottom-3 right-3 bg-black/50 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full">
                  <%= @property.imagenes.size %> fotos
                </span>
              <% end %>
            </button>
          <% end %>
        </div>

        <%# Lightbox %>
        <div data-gallery-target="lightbox"
             data-action="click->gallery#backdropClick touchstart->gallery#touchstart touchend->gallery#touchend"
             class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center">

          <%# Cerrar %>
          <button type="button" data-action="click->gallery#close"
                  class="absolute top-4 right-4 z-10 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-2 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>

          <%# Contador %>
          <span data-gallery-target="counter"
                class="absolute top-4 left-1/2 -translate-x-1/2 text-white/70 text-sm font-medium bg-black/30 px-3 py-1 rounded-full">
          </span>

          <%# Flecha anterior %>
          <button type="button" data-gallery-target="prev" data-action="click->gallery#prev"
                  class="absolute left-3 sm:left-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-3 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <%# Spinner de carga %>
          <div data-gallery-target="spinner" class="hidden absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="w-10 h-10 border-4 border-white/20 border-t-white rounded-full animate-spin"></div>
          </div>

          <%# Imagen principal %>
          <img data-gallery-target="lightboxImg" src="" alt=""
               style="transition: opacity 0.2s ease;"
               class="max-h-[85vh] max-w-[90vw] object-contain rounded-lg shadow-2xl select-none">

          <%# Flecha siguiente %>
          <button type="button" data-gallery-target="next" data-action="click->gallery#next"
                  class="absolute right-3 sm:right-6 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 rounded-full p-3 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

        </div>

      </div>
    <% else %>
      <div class="h-72 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
        <svg class="w-20 h-20 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
        </svg>
      </div>
    <% end %>

    <!-- Info -->
    <div class="p-8 lg:p-10">
      <div class="flex flex-wrap items-start justify-between gap-6 mb-8">
        <div>
          <div class="flex gap-2 mb-3">
            <span class="<%= @property.tipo_operacion == 'venta' ? 'bg-cyan-50 text-cyan-700' : 'bg-gray-100 text-gray-600' %> font-bold px-4 py-1.5 rounded-full text-xs uppercase tracking-wide">
              En <%= @property.tipo_operacion %>
            </span>
            <span class="bg-gray-100 text-gray-600 font-semibold px-4 py-1.5 rounded-full text-xs capitalize">
              <%= @property.tipo_propiedad %>
            </span>
          </div>
          <h1 class="text-3xl font-bold text-gray-900 mb-1 tracking-tight"><%= @property.calle %></h1>
          <p class="text-gray-400 font-medium"><%= @property.colonia %>, <%= @property.ciudad %>, <%= @property.estado %></p>
        </div>
        <div class="text-right">
          <p class="text-4xl font-bold text-olive-600 tracking-tight"><%= @property.precio_formateado %></p>
          <% if @property.tipo_operacion == "renta" %>
            <p class="text-xs text-gray-400 mt-1">por mes</p>
          <% end %>
        </div>
      </div>

      <!-- Botón WhatsApp -->
      <a href="<%= wa_url %>" target="_blank" rel="noopener"
         class="flex items-center justify-center gap-3 w-full bg-green-500 hover:bg-green-400 active:bg-green-600 text-white font-bold py-4 rounded-2xl transition-all shadow-lg text-base mb-8">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Contactar por WhatsApp
      </a>

      <% if @property.descripcion.present? %>
        <div class="border-t border-gray-100 pt-8 mb-8">
          <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Descripción</h2>
          <p class="text-gray-600 leading-relaxed whitespace-pre-line text-[15px]"><%= @property.descripcion %></p>
        </div>
      <% end %>

      <div class="border-t border-gray-100 pt-8">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Ubicación</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <% [["Calle", @property.calle], ["Colonia", @property.colonia], ["Ciudad", @property.ciudad], ["Estado", @property.estado]].each do |label, val| %>
            <div class="bg-gray-50 rounded-2xl p-4">
              <p class="text-xs text-gray-400 mb-1"><%= label %></p>
              <p class="text-sm font-semibold text-gray-800"><%= val %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Propiedades similares -->
  <% if @similares.any? %>
    <div class="mt-14">
      <h2 class="text-xl font-bold text-gray-700 mb-6">Propiedades similares</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @similares.each do |property| %>
          <%= link_to property_path(property), class: "bg-white rounded-3xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-200 group block" do %>
            <div class="h-44 bg-gray-100 relative rounded-3xl overflow-hidden">
              <% if property.imagen_principal %>
                <%= image_tag url_for(property.imagen_principal),
                      class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500",
                      loading: "lazy",
                      decoding: "async",
                      alt: "" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
                  <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                  </svg>
                </div>
              <% end %>
              <div class="absolute top-3 left-3">
                <span class="bg-gray-900/75 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                  EN <%= property.tipo_operacion.upcase %>
                </span>
              </div>
            </div>
            <div class="px-4 -mt-4 relative z-10">
              <span class="bg-olive-600 text-white font-bold text-sm px-4 py-2 rounded-2xl shadow-lg inline-block whitespace-nowrap">
                <%= property.precio_formateado %>
              </span>
            </div>
            <div class="px-4 pb-5 pt-2">
              <p class="text-sm font-semibold text-gray-800 truncate">
                <%= property.tipo_propiedad.capitalize %> en <%= property.colonia %>
              </p>
              <p class="text-xs text-gray-400 mt-0.5 truncate"><%= property.ciudad %>, <%= property.estado %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
