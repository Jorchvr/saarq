#!/bin/bash -e

# Fix storage volume permissions — Railway mounts volumes as root but the app
# runs as the rails process, so we ensure the directory is writable.
mkdir -p /rails/storage
chmod -R 755 /rails/storage

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:migrate:queue 2>/dev/null || ./bin/rails db:schema:load:queue 2>/dev/null || true
fi

exec "${@}"
